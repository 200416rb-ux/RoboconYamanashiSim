<?xml version='1.0' encoding='utf-8'?>
<robot name="perorin">
  <!-- ================================================================ -->
  <!-- Robot: ぺろりん / internal URDF identifier: perorin              -->
  <!-- Coordinates: ROS X=forward, Y=left, Z=up; dimensions are metres. -->
  <!-- ================================================================ -->

  <!-- DRIVE SYSTEM
       Three independently steered wheels are driven through 20:40 gears.
       Steering zero offsets and motor speed are calibrated in the Unity controller. -->

  <!-- CLUB SYSTEM
       The tongue club and catch share the circular rail fitted from part_334.
       Rail centre in ROS X/Z = (-0.065574, 0.226767), radius = 0.221 m.
       Catch top = analog 0; catch bottom = analog 1023 (10 bit, 1024 steps).
       The catch claw is passive during normal travel. Its servo drives and
       holds the claw upward only while releasing the club. -->

  <!-- APPEARANCE NOTE
       Motors, circuits and the touch monitor remain separately identifiable.
       LED appearance/emission is a Unity material setting; it does not change URDF joints. -->

  <!-- ==================== FIXED CHASSIS AND PARTS ==================== -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="8" />
      <inertia ixx="0.08" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.08" />
    </inertial>
